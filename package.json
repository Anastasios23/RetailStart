{
  "name": "retail-starter",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "pnpm --filter @retail-starter/backend build && pnpm --filter @retail-starter/storefront build",
    "db:migrate": "pnpm --filter @retail-starter/backend db:migrate",
    "dev": "pnpm --parallel --filter @retail-starter/backend --filter @retail-starter/storefront dev",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:status": "docker compose -f infra/docker-compose.yml ps",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "infra:media:up": "docker compose -f infra/docker-compose.yml --profile media up -d minio",
    "lint": "pnpm --filter @retail-starter/backend lint",
    "test": "pnpm --filter @retail-starter/backend test && pnpm --filter @retail-starter/storefront test",
    "typecheck": "pnpm --filter @retail-starter/backend typecheck && pnpm --filter @retail-starter/storefront typecheck"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.21.0",
    "eslint": "9.39.5",
    "jiti": "2.7.0"
  }
}
