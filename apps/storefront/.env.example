# The server-side Store API boundary requires all four values.
# Do not expose these through NEXT_PUBLIC_* variables.
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_replace_with_local_development_storefront_key
MEDUSA_REGION_ID=reg_replace_with_local_development_region_id
MEDUSA_COUNTRY_CODE=CY
# Server-only; must match backend CATALOG_ENSURE_SECRET for browse→cart ensure.
CATALOG_ENSURE_SECRET=replace-with-local-catalog-ensure-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
